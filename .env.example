# Example environment variables (DO NOT put secrets here)
# Copy this file to `.env` and fill in real values before running.

# Required
DISCORD_TOKEN=

# Optional: raises the NVD CVE API rate limit for "nvd-cve" type feeds
# (5 req/30s unauthenticated, 50 req/30s with a key). Request one at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional runtime overrides (uncomment and set to override the default
# shown - leaving one uncommented but blank will crash on startup for the
# numeric ones, so remove/comment the line instead of blanking it)
# FEEDS_FILE=feeds.json
# CHANNELS_FILE=channels.json
# DB_FILE=news.db
# ARTICLES_PER_FEED=5
# FEED_CHECK_INTERVAL_MINUTES=15

# Example environment variables (DO NOT put secrets here)
# Copy this file to `.env` and fill in real values before running.

# Required
DISCORD_TOKEN=

# Optional: seed CHANNELS on first run (integers - Discord channel IDs)
TELECOM_CHANNEL_ID=
FIBER_CHANNEL_ID=
WIRELESS_CHANNEL_ID=
CLOUD_CHANNEL_ID=
AI_CHANNEL_ID=
CYBER_CHANNEL_ID=
REGULATORY_CHANNEL_ID=
CARRIER_CHANNEL_ID=
DATACENTER_CHANNEL_ID=

# Optional: raises the NVD CVE API rate limit for "nvd-cve" type feeds
# (5 req/30s unauthenticated, 50 req/30s with a key). Request one at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional runtime overrides
FEEDS_FILE=feeds.json
CHANNELS_FILE=channels.json
DB_FILE=news.db
ARTICLES_PER_FEED=5
FEED_CHECK_INTERVAL_MINUTES=15
